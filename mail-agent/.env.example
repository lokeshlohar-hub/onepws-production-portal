# Copy to mail-agent/.env on sys160 and fill in. NEVER commit the real .env.

# The portal the agent polls for queued messages.
PORTAL_URL=https://onepws-portal-207920932496.asia-south1.run.app

# Shared secret. Must match MAIL_AGENT_TOKEN set on the Cloud Run service.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_AGENT_TOKEN=

# How often to check for queued mail, in seconds (minimum 5).
POLL_SECONDS=20

# The factory's internal mail server. Reachable only from the LAN, which is
# the whole reason this agent exists.
SMTP_HOST=192.168.100.5
SMTP_PORT=25
# The server advertises AUTH LOGIN and no STARTTLS, so this stays false.
SMTP_SECURE=false
SMTP_USER=production@workspace.com
SMTP_PASS=
# Optional. Defaults to "ONEPWS Production Portal <SMTP_USER>".
SMTP_FROM=
