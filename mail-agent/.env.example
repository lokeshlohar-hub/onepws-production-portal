# Copy to mail-agent/.env on sys160 and fill in. NEVER commit the real .env.

# The portal the agent polls for queued messages.
PORTAL_URL=https://onepws-portal-207920932496.asia-south1.run.app

# Shared secret. Must match MAIL_AGENT_TOKEN set on the Cloud Run service.
MAIL_AGENT_TOKEN=

# How often to check for queued mail, in seconds (minimum 5).
POLL_SECONDS=20

# The factory's internal mail server. Reachable only from the LAN, which is
# the whole reason this agent exists.
SMTP_HOST=192.168.100.5
SMTP_PORT=25
# The server advertises AUTH LOGIN and no STARTTLS, so this stays false.
SMTP_SECURE=false

# --- Sender identity ------------------------------------------------------
# Run `node probe.js` first: it reports whether THIS machine may send without
# a login. sys160 is on the mail server's own subnet, which is commonly
# trusted, so this is worth checking before asking IT for an account.
#
#  * If probe.js says a login is NOT needed:
#       leave SMTP_USER and SMTP_PASS blank and set SMTP_FROM below.
#  * If probe.js says a login IS required:
#       fill in SMTP_USER and SMTP_PASS with a real mailbox account.
#
# NOTE: production@workspace.com is a distribution GROUP, not a mailbox — it
# has no password and cannot be used to log in. It is a fine recipient.
SMTP_USER=
SMTP_PASS=

# The address handover notifications appear to come from.
SMTP_FROM=ONEPWS Production Portal <portal@workspace.com>
